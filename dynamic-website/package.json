{
  "name": "kidney-map-prototype",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/copy-ocr.mjs",
    "assets": "node scripts/copy-ocr.mjs",
    "samples": "node scripts/make-samples.mjs",
    "check:scope": "node scripts/scope-check.mjs",
    "prebuild": "node scripts/copy-ocr.mjs && node scripts/scope-check.mjs",
    "build": "tsc --noEmit && vite build",
    "build:single": "node scripts/scope-check.mjs && vite build --mode single",
    "preview": "vite preview --port 4173",
    "start": "node server/start.mjs",
    "test:voice": "node --test server/voice.test.mjs",
    "check:voice": "node scripts/check-voice.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "check:keys": "node scripts/check-keys.mjs",
    "phrases:review": "node scripts/phrase-review.mjs"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/noto-sans-bengali": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "html-to-image": "^1.11.13",
    "pdfjs-dist": "^5.6.205",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@playwright/test": "^1.65.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.2.1",
    "pdf-lib": "^1.17.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
