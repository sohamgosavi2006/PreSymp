# Copy this file to .env and fill in your keys. .env is git-ignored. Never commit real keys.
#
# The app server uses SARVAM_API_KEY for opt-in speech and transcription.
# ANTHROPIC_API_KEY is used only by developer scripts.
#
# Do NOT rename them with a VITE_ prefix. Vite copies every VITE_ variable into the
# browser bundle, so anyone who opens the site could read the key.

SARVAM_API_KEY=
ANTHROPIC_API_KEY=

# Optional: cheaper models for a demo (check the current model ids before use)
ANTHROPIC_MODEL=claude-haiku-5-5
